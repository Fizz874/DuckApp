@model Strzelecki_Baranowski.DuckApp.WebUI.Models.Producer

@{
    ViewData["Title"] = @Model.Name;
}

<div class="container my-5">

    <div class="card border-0 shadow rounded-4 mb-5">
        <div class="card-body p-5">
            <div class="row align-items-center">
                <div class="col-md-2 text-center">
                    <div class="bg-light rounded-circle d-inline-flex p-4">
                        <span class="display-4">🏭</span>
                    </div>
                </div>
                <div class="col-md-8">
                    <h5 class="text-uppercase text-muted fw-bold small ls-1">Manufacturer</h5>
                    <h1 class="display-5 fw-bold text-dark">@Model.Name</h1>

                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <a href="@Model.Website" target="_blank" class="text-primary text-decoration-none fs-5 fw-semibold">
                            @Model.Website ↗
                        </a>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">No website provided</span>
                    }
                </div>

                <div class="col-md-2 text-end">
                    <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-light border fw-bold w-100 mb-2">
                        Edit
                    </a>

                    <a asp-action="Delete" asp-route-id="@Model.ID" class="btn btn-danger fw-bold w-100 mb-2">
                        Delete
                    </a>

                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        Back
                    </a>
                </div>

            </div>
        </div>
    </div>

    <h3 class="fw-bold mb-4 ps-2 border-start border-4 border-primary">
        &nbsp;Products by @Model.Name
    </h3>

    @if (Model.Ducks != null && Model.Ducks.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
            @foreach (var duck in Model.Ducks)
            {
                <div class="col">
                    <div class="card h-100 border shadow-sm rounded-3 overflow-hidden">
                        <div class="bg-light p-3 text-center" style="height: 150px;">
                            <img src="/photos/@duck.PhotoFileName"
                                 class="img-fluid h-100"
                                 style="object-fit: contain;"
                                 onerror="this.src='/photos/0.png'" />
                        </div>
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-truncate" title="@duck.Name">@duck.Name</h6>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="text-success fw-bold">@duck.Price.ToString("C")</span>
                                <a asp-controller="Ducks" asp-action="Details" asp-route-id="@duck.ID" class="btn btn-sm btn-primary rounded-pill px-3">
                                    View
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border text-center py-5 rounded-3">
            <h4 class="text-muted">No products found for this manufacturer.</h4>
            <p class="mb-0">Add a new duck and assign it to <strong>@Model.Name</strong>.</p>
        </div>
    }
</div>