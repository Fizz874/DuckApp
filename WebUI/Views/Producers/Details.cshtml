@model Strzelecki_Baranowski.DuckApp.WebUI.Models.Producer

@{
    ViewData["Title"] = Model.Name;
}

<div class="container my-5">

    <div class="card border-0 shadow-lg rounded-4 mb-5 overflow-hidden">
        <div class="card-body p-5">
            <div class="row align-items-center">

                <div class="col-md-2 text-center mb-3 mb-md-0">
                    <div class="bg-light rounded-circle d-inline-flex p-4 shadow-sm">
                        <span class="display-4">🏭</span>
                    </div>
                </div>

                <div class="col-md-7 mb-3 mb-md-0">
                    <h5 class="text-uppercase text-muted fw-bold small ls-1 mb-1">Producer</h5>
                    <h1 class="display-5 fw-bold text-dark mb-2">@Model.Name</h1>

                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <a href="@Model.Website" target="_blank" class="text-primary text-decoration-none fs-5 fw-semibold d-inline-flex align-items-center gap-2">
                            🌐 @Model.Website ↗
                        </a>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">No website provided</span>
                    }

                    <div class="mt-3">
                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2">
                            ID: @Model.ID
                        </span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning text-dark fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                            ✏️ Edit
                        </a>

                        <a asp-action="Delete" asp-route-id="@Model.ID" class="btn btn-danger fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                            🗑️ Delete
                        </a>

                        <a asp-action="Index" class="btn btn-light border fw-semibold mt-2">
                            &larr; Back to List
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold m-0 ps-3 border-start border-5 border-primary">
            Products by @Model.Name
        </h3>
        <span class="badge bg-primary rounded-pill ms-3">@Model.Ducks.Count</span>
    </div>

    @if (Model.Ducks != null && Model.Ducks.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
            @foreach (var duck in Model.Ducks)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover-effect">

                        <div class="bg-light p-4 text-center position-relative" style="height: 180px;">
                            <a asp-controller="Ducks" asp-action="Details" asp-route-id="@duck.ID" class="d-block h-100 w-100">
                                <img src="/photos/@duck.PhotoFileName"
                                     class="img-fluid h-100"
                                     style="object-fit: contain; transition: transform 0.3s ease;"
                                     onerror="this.src='/photos/0.png'" />
                            </a>
                        </div>

                        <div class="card-body p-3">
                            <h6 class="fw-bold text-truncate mb-1" title="@duck.Name">
                                <a asp-controller="Ducks" asp-action="Details" asp-route-id="@duck.ID" class="text-decoration-none text-dark stretched-link">
                                    @duck.Name
                                </a>
                            </h6>

                            <div class="d-flex justify-content-between align-items-end mt-3">
                                <span class="text-success fw-bold fs-5">
                                    @duck.Price.ToString("C", new System.Globalization.CultureInfo("fr-FR"))
                                </span>
                                <small class="text-muted">ID: @duck.ID</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border-0 shadow-sm text-center py-5 rounded-4">
            <div class="display-1 text-muted opacity-25 mb-3">🦆</div>
            <h4 class="text-muted fw-bold">No products found.</h4>
            <p class="mb-3 text-secondary">This producer currently has no ducks assigned.</p>
            <a asp-controller="Ducks" asp-action="Add" class="btn btn-outline-primary rounded-pill px-4">
                Add New Duck
            </a>
        </div>
    }
</div>

<style>
    .card-hover-effect {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card-hover-effect:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.15) !important;
        }

            .card-hover-effect:hover img {
                transform: scale(1.05);
            }
</style>