@model Strzelecki_Baranowski.DuckApp.WebUI.Models.Producer

@{
    ViewData["Title"] = "Edit Producer";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-5 text-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 mb-3">
                        <span class="fs-2">🏭</span>
                    </div>
                    <h2 class="fw-bold text-dark">Edit Producer</h2>
                    <p class="text-muted">Update company details.</p>
                </div>

                <div class="card-body p-5 pt-2">
                    <form asp-action="Edit">

                        <input type="hidden" asp-for="ID" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center fw-bold"></div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-secondary small text-uppercase ls-1"></label>
                            <input asp-for="Name" class="form-control form-control-lg bg-light border-0" placeholder="Enter company name..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-5">
                            <label asp-for="Website" class="form-label fw-bold text-secondary small text-uppercase ls-1"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 text-muted">🌐</span>
                                <input asp-for="Website" class="form-control form-control-lg bg-light border-0" placeholder="https://example.com" />
                            </div>
                            <span asp-validation-for="Website" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-light btn-lg px-4 border fw-semibold">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold shadow-sm">Save Changes</button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <style>
        .input-validation-error {
            border: 2px solid #dc3545 !important;
            background-color: #fff8f8 !important;
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25) !important;
        }

        .field-validation-error {
            color: #dc3545 !important;
            font-weight: bold;
            font-size: 0.85em;
            margin-top: 5px;
            display: block;
        }

        .input-validation-valid {
            border: 2px solid #198754 !important;
        }
    </style>

    <script>
        $(document).ready(function () {
            // Force validation on every keystroke (input propertychange)            
            $("form").find("input, select, textarea").on("input propertychange", function () {
                $(this).valid();
            });
        });
    </script>
}