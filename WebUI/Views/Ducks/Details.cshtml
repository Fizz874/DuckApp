@model Strzelecki_Baranowski.DuckApp.WebUI.Models.Duck

@{
    ViewData["Title"] = "Details";
}

<div class="container mt-5">

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="row g-0">

            <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4">
                <div class="bg-white p-2 rounded-3 shadow-sm" style="max-width: 100%;">
                    <img src="/photos/@Model.PhotoFileName"
                         alt="@Model.Name"
                         class="img-fluid rounded"
                         style="max-height: 400px; object-fit: contain;"
                         onerror="this.src='/photos/0.png'" />
                </div>
            </div>

            <div class="col-md-7 p-5">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-primary bg-opacity-10 text-primary fs-6 px-3 py-2 rounded-pill text-uppercase">
                        @Model.Category
                    </span>
                    <small class="text-muted fw-bold">ID: @Model.ID</small>
                </div>

                <h1 class="display-5 fw-bold text-dark mb-2">@Model.Name</h1>

                <p class="text-muted mb-4">
                    Manufacturer:
                    <a asp-controller="Producers" asp-action="Details" asp-route-id="@Model.ProducerID" class="text-decoration-none fw-bold text-primary">
                        @(Model.Producer?.Name ?? "Unknown")
                    </a>
                </p>

                <div class="mb-4">
                    <span class="display-6 fw-bold text-success">@Model.Price.ToString("C", new System.Globalization.CultureInfo("fr-FR"))</span>
                </div>

                <hr class="text-secondary opacity-25 my-4" />

                <div class="mb-5">
                    <h6 class="text-uppercase text-secondary fw-bold small ls-1">Description</h6>
                    <p class="text-secondary fs-5" style="line-height: 1.6;">
                        @Model.Description
                    </p>
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                    <a asp-action="Index" class="btn btn-light border px-4 py-2 fw-semibold shadow-sm">
                        &larr; Back
                    </a>

                    <div class="d-flex gap-2">

                        <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning text-dark px-4 py-2 fw-bold shadow-sm d-flex align-items-center gap-2">
                            ✏️ Edit
                        </a>

                        <a asp-action="Delete" asp-route-id="@Model.ID" class="btn btn-danger text-white px-4 py-2 fw-bold shadow-sm d-flex align-items-center gap-2">
                            🗑️ Delete
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>