@model Strzelecki_Baranowski.DuckApp.WebUI.Models.Duck

@{
    ViewData["Title"] = "Edit Duck";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-5">
                    <h2 class="fw-bold text-dark">Edit Duck</h2>
                    <p class="text-muted">Update product details below.</p>
                </div>

                <div class="card-body p-5 pt-2">
                    <form asp-action="Edit" enctype="multipart/form-data">

                        <input type="hidden" asp-for="ID" />
                        <input type="hidden" asp-for="Photo" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-secondary small text-uppercase ls-1"></label>
                            <input asp-for="Name" class="form-control form-control-lg bg-light border-0" placeholder="Enter duck name..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Category" class="form-label fw-bold text-secondary small text-uppercase ls-1"></label>
                                <select asp-for="Category" class="form-select form-select-lg bg-light border-0"
                                        asp-items="Html.GetEnumSelectList<Strzelecki_Baranowski.DuckApp.CORE.Category>()">
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Price" class="form-label fw-bold text-secondary small text-uppercase ls-1"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0">€</span>
                                    <input asp-for="Price" class="form-control form-control-lg bg-light border-0" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ProducerID" class="form-label fw-bold text-secondary small text-uppercase ls-1"></label>
                            <select asp-for="ProducerID" class="form-select form-select-lg bg-light border-0" asp-items="ViewBag.ProducersList">
                                <option value=""></option>
                            </select>
                            <span asp-validation-for="ProducerID" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold text-secondary small text-uppercase ls-1"></label>
                            <textarea asp-for="Description" class="form-control bg-light border-0" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-5 p-4 rounded bg-light border">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Photo Settings</label>

                            <div class="row align-items-center">
                                <div class="col-md-3 text-center">
                                    <img id="imagePreview"
                                         src="/photos/@Model.PhotoFileName"
                                         data-original-src="/photos/@Model.PhotoFileName"
                                         style="height: 120px; object-fit: contain;"
                                         class="rounded border bg-white p-2 shadow-sm"
                                         onerror="this.src='/photos/0.png'" />

                                    <div class="small text-muted mt-2 fw-bold" id="previewLabel">Obecne</div>
                                </div>

                                <div class="col-md-9">
                                    <label asp-for="PhotoUpload" class="form-label">Wgraj nowe zdjęcie (opcjonalnie)</label>

                                    <input asp-for="PhotoUpload"
                                           class="form-control"
                                           type="file"
                                           accept="image/*"
                                           onchange="previewFile(this)" />

                                    <span asp-validation-for="PhotoUpload" class="text-danger small"></span>
                                    <div class="form-text text-muted">Wybranie nowego pliku automatycznie zaktualizuje podgląd po lewej.</div>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-light btn-lg px-4 border fw-semibold">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold shadow-sm">Save Changes</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }



    <script>
        function previewFile(input) {
            // Znajdź obrazek i etykietę
            var preview = document.getElementById('imagePreview');
            var label = document.getElementById('previewLabel');

            // Pobierz oryginalną ścieżkę (w razie anulowania)
            var originalSrc = preview.getAttribute('data-original-src');

            if (input.files && input.files[0]) {
                // Jeśli wybrano plik:
                var reader = new FileReader();

                reader.onload = function (e) {
                    // Podmień źródło obrazka na dane z pliku
                    preview.src = e.target.result;
                    // Zmień napis pod obrazkiem
                    label.innerText = "Nowe (Podgląd)";
                    label.className = "small text-success mt-2 fw-bold";
                }

                reader.readAsDataURL(input.files[0]);
            } else {
                // Jeśli anulowano wybór (brak pliku):
                preview.src = originalSrc;
                label.innerText = "Obecne";
                label.className = "small text-muted mt-2 fw-bold";
            }
        }
    </script>
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }

        <style>
            /* To klasa, którą ASP.NET dodaje automatycznie, gdy jest błąd */
            .input-validation-error {
                border: 2px solid #dc3545 !important; /* Czerwona ramka */
                background-color: #fff8f8 !important; /* Lekko czerwone tło */
                box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25) !important; /* Czerwona poświata */
            }

            /* Kolor tekstu błędu */
            .field-validation-error {
                color: #dc3545 !important;
                font-weight: bold;
                font-size: 0.85em;
                margin-top: 5px;
                display: block;
            }

            /* Zielona ramka, jak jest dobrze (opcjonalnie, dla lepszego efektu) */
            .input-validation-valid {
                border: 2px solid #198754 !important; /* Zielona ramka */
            }
        </style>

        <script>
            $(document).ready(function () {
                // Znajdujemy formularz
                var form = $("form");

                // Wymuszamy walidację przy każdym zdarzeniu 'input' (czyli przy każdym naciśnięciu klawisza)
                form.find("input, select, textarea").on("input propertychange", function () {
                    $(this).valid(); // To ręcznie odpala walidację jQuery
                });

                // LOGIKA PODGLĄDU ZDJĘCIA (Twoja poprzednia funkcja)
                window.previewFile = function(input) {
                    var preview = document.getElementById('imagePreview');
                    var label = document.getElementById('previewLabel');
                    var originalSrc = preview.getAttribute('data-original-src');

                    if (input.files && input.files[0]) {
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            preview.src = e.target.result;
                            label.innerText = "Nowe (Podgląd)";
                            label.className = "small text-success mt-2 fw-bold";
                        }
                        reader.readAsDataURL(input.files[0]);
                    } else {
                        preview.src = originalSrc;
                        label.innerText = "Obecne";
                        label.className = "small text-muted mt-2 fw-bold";
                    }
                };
            });
        </script>
}