            <Expander Grid.Row="1" 
          Header="Filters"
          ExpandDirection="Down"
          Padding="5"
          Margin="0,0,0,10"
          FontSize="14"
          FontWeight="SemiBold"
          Grid.IsSharedSizeScope="True">

                <Expander.Resources>
                    <Style TargetType="Button" x:Key="FilterButtonStyle">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Height" Value="35"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#e5e7eb"/>
                                            <Setter Property="Foreground" Value="#9ca3af"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Expander.Resources>

                <Border Background="White" 
            BorderBrush="#e5e7eb" 
            BorderThickness="1" 
            CornerRadius="10" 
            Padding="15"
            Margin="5">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                    </Border.Effect>

                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding ActiveFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FilterLabelColumn"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                       Text="{Binding PropertyName}" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Medium"
                                       Foreground="#4b5563"/>
                                        <local:FilterControl Grid.Column="2" 
                                                 FilterType="{Binding Type, Mode=TwoWay}" 
                                                 FilterMode="{Binding Operator, Mode=TwoWay}" 
                                                 FilterValue="{Binding Value, Mode=TwoWay}" 
                                                 Height="30"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                        Content="Reset" 
                        Command="{Binding ResetFiltersCommand}" 
                        Style="{StaticResource FilterButtonStyle}"
                        Background="#f3f4f6"
                        Foreground="#374151"/>

                            <Button Grid.Column="2" 
                        Content="Apply" 
                        Command="{Binding ApplyFiltersCommand}" 
                        Style="{StaticResource FilterButtonStyle}"
                        Background="#3b82f6" 
                        Foreground="White"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>

            <!--<ListView Name="Lista" ItemsSource ="{Binding DisplayedList}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" 
          SelectionMode="Single" Grid.Column="0" Grid.Row="2" Margin="5"
              DisplayMemberPath="Name"/>-->

            <ListView Name="Lista" 
          ItemsSource="{Binding DisplayedList}" 
          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
          SelectionMode="Single"
          Grid.Column="0" 
          Grid.Row="2" 
          Margin="5"
          BorderThickness="0"
          Background="Transparent"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" CornerRadius="10" Background="White" BorderBrush="#e5e7eb" BorderThickness="1" Padding="10">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                                        </Border.Effect>
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#f0f9ff"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#bae6fd"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#eff6ff"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3b82f6"/>
                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.Resources>

                    <DataTemplate DataType="{x:Type local:DuckViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#fef3c7" Margin="0,0,15,0">
                                <TextBlock Text="🦆" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#1f2937"/>
                                <TextBlock Text="{Binding ID, StringFormat=ID: {0}}" Foreground="#9ca3af" FontSize="12"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" 
                           Text="{Binding Price, StringFormat={}{0:C} €}" 
                           FontSize="18" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type local:ProducerViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#ede9fe" Margin="0,0,15,0">
                                <TextBlock Text="🏭" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#1f2937"/>
                                <TextBlock Text="{Binding ID, StringFormat=Producer ID: {0}}" Foreground="#9ca3af" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>

                </ListView.Resources>
            </ListView>
