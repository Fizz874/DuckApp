<Window x:Class="Strzelecki_Baranowski.DuckApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Strzelecki_Baranowski.DuckApp.UI"
        xmlns:interfaces="clr-namespace:Strzelecki_Baranowski.DuckApp.INTERFACES;assembly=INTERFACES"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="DuckApp" Height="800" Width="1500"
        Icon="/duck_logo.ico"
        Name="Okno">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#3b82f6"/>
        <SolidColorBrush x:Key="HoverColor" Color="#bfdbfe"/>
        <SolidColorBrush x:Key="InactiveColor" Color="#e5e7eb"/>

        <SolidColorBrush x:Key="AddColor" Color="#10b981"/>
        <SolidColorBrush x:Key="AddHover" Color="#34d399"/>
        <SolidColorBrush x:Key="DeleteColor" Color="#ef4444"/>
        <SolidColorBrush x:Key="DeleteHover" Color="#f87171"/>
        <SolidColorBrush x:Key="EditColor" Color="#f59e0b"/>
        <SolidColorBrush x:Key="EditHover" Color="#fbbf24"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#1f2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6b7280"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9ca3af"/>
        <SolidColorBrush x:Key="BorderColor" Color="#e5e7eb"/>
        <SolidColorBrush x:Key="InputBg" Color="#f9fafb"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="5" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="BaseButtonTemplate" TargetType="Button">
            <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Background" Value="{StaticResource InactiveColor}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource InactiveColor}"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template" Value="{StaticResource BaseButtonTemplate}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EditVisibility}" Value="Visible">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AddColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AddHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DeleteColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeleteHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource EditColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource EditHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}"/>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource BaseButtonTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource InactiveColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template" Value="{StaticResource BaseButtonTemplate}"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style x:Key="ModernInput" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DeleteColor}"/>
                                <Setter TargetName="border" Property="Background" Value="#fef2f2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="5"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="MainListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder" CornerRadius="10" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#f0f9ff"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#bae6fd"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#eff6ff"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Column="0" Grid.Row="0" Columns="2" Margin="10">
                <Button Content="Ducks" Command="{Binding ShowDucksCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ListType}" Value="ducks">
                                    <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Producers" Command="{Binding ShowProducersCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ListType}" Value="producers">
                                    <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>

            <Expander Grid.Row="1" Header="Filters" ExpandDirection="Down" Padding="5" Margin="0,0,0,10" FontSize="14" FontWeight="SemiBold" Grid.IsSharedSizeScope="True">
                <Border Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                    </Border.Effect>

                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding ActiveFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FilterLabelColumn"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding PropertyName}" VerticalAlignment="Center" FontWeight="Medium" Foreground="#4b5563"/>
                                        <local:FilterControl Grid.Column="2" FilterType="{Binding Type, Mode=TwoWay}" FilterMode="{Binding Operator, Mode=TwoWay}" FilterValue="{Binding Value, Mode=TwoWay}" Height="30" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Reset" Command="{Binding ResetFiltersCommand}" Style="{StaticResource FilterButtonStyle}" Background="#f3f4f6" Foreground="#374151"/>
                            <Button Grid.Column="2" Content="Apply" Command="{Binding ApplyFiltersCommand}" Style="{StaticResource FilterButtonStyle}" Background="{StaticResource PrimaryColor}" Foreground="White"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>

            <ListView Name="Lista" ItemsSource="{Binding DisplayedList}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SelectionMode="Single" Grid.Row="2" Margin="5" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource MainListViewItemStyle}">
                <ListView.Resources>
                    <DataTemplate DataType="{x:Type local:DuckViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#fef3c7" Margin="0,0,15,0">
                                <TextBlock Text="🦆" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="{Binding ID, StringFormat=ID: {0}}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat={}{0:C} €}" FontSize="18" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type local:ProducerViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#ede9fe" Margin="0,0,15,0">
                                <TextBlock Text="🏭" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="{Binding ID, StringFormat=Producer ID: {0}}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.Resources>
            </ListView>

            <UniformGrid Grid.Row="3" Grid.Column="0" Columns="3" Margin="5 5 5 25" >
                <Button Content="Add" Command="{Binding AddItemCommand}" Style="{StaticResource AddButtonStyle}"/>
                <Button Content="Delete" Command="{Binding DeleteItemCommand}" Style="{StaticResource DeleteButtonStyle}"/>
                <Button Content="Edit" Command="{Binding EditItemCommand}" Style="{StaticResource EditButtonStyle}"/>
            </UniformGrid>
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.Column="2">
            <Grid>
                <ContentControl Name="DetailsView" Visibility="{Binding DetailsVisibility}" Content="{Binding ElementName=Lista, Path=SelectedItem}" Margin="10">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type local:DuckViewModel}">
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid Margin="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="250"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True" Background="#f9fafb" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" VerticalAlignment="Top">
                                        <Image Source="{Binding FullPhotoPath, TargetNullValue='photos/0.png', FallbackValue='photos/0.png'}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="25,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Background="#dbeafe" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Category}" Foreground="#1e40af" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                            <Border Background="#f3f4f6" CornerRadius="4" Padding="8,4">
                                                <TextBlock Text="{Binding ID, StringFormat=ID: {0}}" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Name}" FontSize="32" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:C} €}" FontSize="36" FontWeight="Black" Foreground="#059669" Margin="0,0,0,20"/>
                                        <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,0,0,20"/>

                                        <TextBlock Text="PRODUCER" Style="{StaticResource LabelText}"/>
                                        <TextBlock Style="{StaticResource ValueText}">
                                            <Hyperlink Command="{Binding DataContext.ShowSpecifiedProducerCommand, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#2563eb" TextDecorations="None">
                                                <Run Text="{Binding ProducerName}"/>
                                            </Hyperlink>
                                        </TextBlock>

                                        <TextBlock Text="DESCRIPTION" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="24"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type local:ProducerViewModel}">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="30">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="100" Height="100" CornerRadius="20" Background="#f5f3ff" VerticalAlignment="Top">
                                        <TextBlock Text="🏭" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PRODUCER PROFILE" Foreground="#8b5cf6" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Name}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding ID, StringFormat=Producer ID: {0}}" FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,0,0,20"/>
                                        <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,0,0,20"/>

                                        <TextBlock Text="WEBSITE" Style="{StaticResource LabelText}"/>
                                        <TextBlock Style="{StaticResource ValueText}">
                                             <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{Binding Website}" Foreground="#2563eb">
                                                 <TextBlock Text="{Binding Website}"/>
                                             </Hyperlink>
                                        </TextBlock>

                                        <Button Content="View All Products" Command="{Binding DataContext.ShowDucksOfrRoducerCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ModernBtn}" HorizontalAlignment="Left" Margin="0,10,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" TextOptions.TextFormattingMode="Display"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>

                <ContentControl Name="EditView" Visibility="{Binding EditVisibility}" Content="{Binding DummyObject}" Margin="10">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type local:DuckViewModel}">
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Border Background="Transparent" Padding="25">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DataContext.FormsHeader, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <Label Content="NAME" Style="{StaticResource FormLabel}"/>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource ModernInput}" Margin="0,0,0,15"/>

                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="15"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <Label Content="CATEGORY" Style="{StaticResource FormLabel}"/>
                                                        <ComboBox SelectedItem="{Binding Category}" ItemsSource="{Binding DataContext.CategoryValues, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ModernCombo}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <Label Content="PRICE (€)" Style="{StaticResource FormLabel}"/>
                                                        <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Label Content="PRODUCER" Style="{StaticResource FormLabel}"/>
                                                <ComboBox SelectedItem="{Binding ProducerVM}" ItemsSource="{Binding DataContext.ProducerVM.Producers, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ModernCombo}" Margin="0,0,0,15">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold"/>
                                                                <Run Text=" (" Foreground="Gray"/>
                                                                <Run Text="{Binding ID, Mode=OneWay}" Foreground="Gray"/>
                                                                <Run Text=")" Foreground="Gray"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <Label Content="DESCRIPTION" Style="{StaticResource FormLabel}"/>
                                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <Label Content="PHOTO PREVIEW" Style="{StaticResource FormLabel}"/>
                                                <Border CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Background="#f9fafb" Height="200" Margin="0,0,0,10">
                                                    <Grid>
                                                        <TextBlock Text="No Image" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="16"/>
                                                        <Border CornerRadius="8" ClipToBounds="True">
                                                            <Image Source="{Binding FullPhotoPath, TargetNullValue='photos/0.png', FallbackValue='photos/0.png'}" Stretch="Uniform"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Button Content="Choose Photo..." Command="{Binding SelectPhotoCommand}" Style="{StaticResource SecondaryBtn}" Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding Photo}" FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Row="2" Margin="0,20,0,0">
                                            <ListBox ItemsSource="{Binding DataContext.Bledy, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="0" Background="#fef2f2" Foreground="#b91c1c" Margin="0,0,0,15">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="5"/>
                                                        <Setter Property="FontSize" Value="13"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Cancel" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryBtn}" Width="100" Margin="0,0,10,0"/>
                                                <Button Content="Save Changes" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryBtn}" Width="140"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type local:ProducerViewModel}">
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Border Background="Transparent" Padding="25">
                                    <StackPanel>

                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="10" Background="#ede9fe" Margin="0,0,15,0">
                                                <TextBlock Text="🏭" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
                                            </Border>

                                            <TextBlock Grid.Column="1" 
                                                Text="{Binding DataContext.FormsHeader, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                FontSize="24" 
                                                FontWeight="Bold" 
                                                Foreground="#111827" 
                                                VerticalAlignment="Center"/> 
                                        </Grid>

                                        <Label Content="COMPANY NAME" Style="{StaticResource FormLabel}"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Margin="0,0,0,15"/>

                                        <Label Content="WEBSITE URL" Style="{StaticResource FormLabel}"/>
                                        <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Margin="0,0,0,25"/>

                                        <ListBox ItemsSource="{Binding DataContext.Bledy, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="0" Background="#fef2f2" Foreground="#b91c1c" Margin="0,0,0,15"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Cancel" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryBtn}" Width="100" Margin="0,0,10,0"/>
                                            <Button Content="Save Company" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryBtn}" Width="140"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
    