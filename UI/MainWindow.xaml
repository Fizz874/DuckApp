                <ContentControl Name="DetailsView" 
                Visibility="{Binding DetailsVisibility}"
                Content="{Binding ElementName=Lista, Path=SelectedItem}"
                Margin="10">

                    <ContentControl.Resources>

                        <Style x:Key="LabelText" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#9ca3af"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                        </Style>

                        <Style x:Key="ValueText" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1f2937"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="0,0,0,15"/>
                        </Style>

                        

                        <DataTemplate DataType="{x:Type local:DuckViewModel}">
                            <Border Background="White" CornerRadius="16" BorderBrush="#f3f4f6" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="5" Opacity="0.08"/>
                                </Border.Effect>

                                <Grid Margin="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="250"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" 
                            CornerRadius="12" 
                            ClipToBounds="True" 
                            Background="#f9fafb" 
                            BorderBrush="#e5e7eb"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                                        <Grid>
                                            <Image Source="{Binding FullPhotoPath, TargetNullValue='photos/0.png', FallbackValue='photos/0.png'}" 
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="25,0,0,0">

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Background="#dbeafe" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
